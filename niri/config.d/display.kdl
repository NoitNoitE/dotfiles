// Built-in Monitor
output "Samsung Display Corp. ATNA40CU05-0  Unknown" {
	variable-refresh-rate
    mode "2880x1800@120.00"
	//mode "1920x1200@120.000"
    scale 2.0
	//scale 1.5
    transform "normal"
    position x=0 y=0
}

output "PNP(AOC) 24G2W1G4 ATNMC1A005826"{
	mode "1920x1080@144.00"
    scale 1.0
	transform "normal"
    position x=-2880 y=0
}

/-output "HDMI-A-1"{
	mode "3840x2160@160.000"
	scale 2.0
	transform "normal"
	position x=0 y=0
}

output "LG Electronics LG TV SSCR2 0x01010101"{
	mode "4096x2160@120.000"
	scale 2.0
	transform "normal"
    position x=-2880 y=0
}

output "ASUSTek COMPUTER INC XG27ACMEG W4LMQS046563"{
	//variable-refresh-rate
	mode "2560x1440@260.001"
	scale 1.0
	transform "normal"
	position x=2880 y=0
}
